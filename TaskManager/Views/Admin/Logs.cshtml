@model IEnumerable<TaskManager.Models.LoginLog>

<h2>Логи входов пользователей</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Вход</th>
            <th>Выход</th>
            <th>IP</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.UserEmail</td>
                <td>@log.LoginTime</td>
                <td>@(log.LogoutTime?.ToString() ?? "ещё в системе")</td>
                <td>@log.IpAddress</td>
            </tr>
        }
    </tbody>
</table>
