@model IEnumerable<TaskManager.Models.TaskItem>

<!-- Страница задач -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Мои задачи</h3>
        <a class="btn btn-success btn-sm" href="/Tasks/Create">
            <i class="fas fa-plus"></i> Создать задачу
        </a>
    </div>

    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.Id</td>
                        <td>@task.Title</td>
                        <td>
                            @if (task.IsDone)
                            {
                                <span class="badge bg-success">Выполнено</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Активно</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-primary btn-sm" href="/Tasks/Edit/@task.Id">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a class="btn btn-danger btn-sm" href="/Tasks/Delete/@task.Id">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
